@model Gerenciador_de_Produtos.Models.ViewModels.ConfiguradorItemERPViewModel
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Mvc.Rendering


@{
    ViewData["Title"] = $"Configurador de {Model.ERP}";

    // Pré-renderiza as opções para injetar no JS
    var itensOptions = string.Join("",
        Model.AllItensERP.Select(i => $"<option value='{i.Value}'>{i.Text}</option>")
    );
    var desenhosOptions = string.Join("",
        Model.AllDesenhos.Select(d => $"<option value='{d.Value}'>{d.Text}</option>")
    );
    var perfisOptions = string.Join("",
        Model.AllPerfisSection.Select(p => $"<option value='{p.Value}'>{p.Text}</option>")
    );
}

<h2 class="text-center fw-bold display-5 my-4">@ViewData["Title"]</h2>

<form asp-action="ConfiguradorItemERP" method="post">
    <input asp-for="Id" type="hidden" />
    <input type="hidden" name="TesteBinding" value="ok" />

    <!-- ==========================================
     Seção 1: Dados Básicos
     ========================================== -->
    <div class="card mb-4">
        <div class="card-header bg-secondary text-white"><strong>Seção 1: Dados Básicos</strong></div>
        <div class="card-body">

            <!-- Campos principais -->
            <div class="row g-4 mb-3">
                <div class="col-md-3">
                    <label asp-for="ERP" class="form-label">Item ERP</label>
                    <input asp-for="ERP" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Descricao" class="form-label">Descrição</label>
                    <input asp-for="Descricao" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="TipoItem" class="form-label">Tipo</label>
                    <input asp-for="TipoItem" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Status" class="form-label">Status</label>
                    <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<Gerenciador_de_Produtos.Models.Enums.StatusItem>()">
                        <option value="">-- selecione --</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>
            </div>

            <!-- Acabamento / Classificação -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light fw-semibold">
                    <i class="bi bi-sliders me-2 text-primary"></i> Opções do Item
                </div>
                <div class="card-body">
                    <div class="row g-4">
                        <!-- Acabamento -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold d-block mb-2">Acabamento</label>
                            <div class="form-check form-check-inline">
                                <input asp-for="Acabamento" class="form-check-input" type="radio" value="Com Acabamento" id="acabCom" />
                                <label class="form-check-label" for="acabCom">Com acabamento</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input asp-for="Acabamento" class="form-check-input" type="radio" value="Sem Acabamento" id="acabSem" />
                                <label class="form-check-label" for="acabSem">Sem acabamento</label>
                            </div>
                        </div>

                        <!-- Classificação -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold d-block mb-2">Classificação</label>
                            <div class="form-check form-check-inline">
                                <input asp-for="Classificacao" class="form-check-input" type="radio" value="1" id="classSimples" />
                                <label class="form-check-label" for="classSimples">Simples</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input asp-for="Classificacao" class="form-check-input" type="radio" value="2" id="classComposta" />
                                <label class="form-check-label" for="classComposta">Composta</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-group mb-3">
                <label asp-for="SelectedTagIds" class="form-label">Tags</label>
                <select asp-for="SelectedTagIds" asp-items="Model.AllTags" multiple class="form-select select2-tags" style="width: 100%"></select>
                <span asp-validation-for="SelectedTagIds" class="text-danger"></span>
            </div>



            <!-- ==========================================
            Seção: Desenhos do Item ERP (NOVO ESTILO)
            ========================================== -->
            <div class="card mb-4">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <strong>Desenhos do Item</strong>
                    <button class="btn btn-sm btn-outline-success" type="button" data-bs-toggle="collapse" data-bs-target="#secaoAdicionarDesenho" aria-expanded="false">
                        <i class="bi bi-plus-circle me-1"></i> Adicionar
                    </button>
                </div>

                <!-- Filtros e busca colapsável -->
                <div class="collapse border-bottom px-3 pt-3" id="secaoAdicionarDesenho">
                    <div class="row g-3 mb-3 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label">Status</label>
                            <select id="filtroStatusDesenho" class="form-select">
                                <option value="">-- Todos --</option>
                                <option value="Ativo">Ativo</option>
                                <option value="NaoAtivo">Não Ativo</option>
                                <option value="Obsoleto">Obsoleto</option>
                            </select>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Buscar desenho</label>
                            <select class="form-select" id="desenhoSelectTemp"></select>
                        </div>
                    </div>

                    <!-- Formulário inline para novo desenho -->
                    <div id="novoDesenhoForm" class="border rounded p-3 mb-3 bg-light collapse">
                        <div class="row g-2">
                            <div class="col-md-3">
                                <label class="form-label">Nome</label>
                                <input type="text" class="form-control form-control-sm" id="novoDesenhoNome" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Descrição</label>
                                <input type="text" class="form-control form-control-sm" id="novoDesenhoDescricao" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Revisão</label>
                                <input type="number" class="form-control form-control-sm" id="novoDesenhoRevisao" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Data de Criação</label>
                                <input type="date" class="form-control form-control-sm" id="novoDesenhoDataCriacao" />
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button type="button" id="btnSalvarNovoDesenho" class="btn btn-sm btn-primary w-100">
                                    Salvar Desenho
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tabela de desenhos vinculados -->
                <div class="card-body">
                    <datalist id="desenhosList">
                        @foreach (var d in Model.AllDesenhos)
                        {
                            <option value="@d.Value">@d.Text</option>
                        }
                    </datalist>

                    <table class="table table-sm mb-2" id="tblDesenhos">
                        <thead class="table-light">
                            <tr>
                                <th>Nome</th>
                                <th>Descrição</th>
                                <th>Rev.</th>
                                <th>Data Criação</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Desenhos.Count; i++)
                            {
                                <tr>
                                    <input type="hidden" asp-for="Desenhos[@i].Id" />
                                    <td><input asp-for="Desenhos[@i].Nome" class="form-control form-control-sm" list="desenhosList" /></td>
                                    <td><input asp-for="Desenhos[@i].Descricao" class="form-control form-control-sm" /></td>
                                    <td><input asp-for="Desenhos[@i].Revisao" class="form-control form-control-sm" /></td>
                                    <td><input asp-for="Desenhos[@i].DataCriacao" type="date" class="form-control form-control-sm" /></td>
                                    <td><button type="button" class="btn btn-sm btn-outline-danger btn-remove-desenho">✕</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>


            @* Comentada chamada do editor de formula aqui, pra lembra dpois*@
            @*@if (Model.Classificacao == 2)
            {
                @Html.Partial("_EditorFormula", Model)
            } *@



            <!-- ==========================================
                 Vínculos e Composição
                 ========================================== -->
            <!-- Bloco: Itens da Composição (Filhos) -->
            <div class="card mb-4">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <strong>Itens Compostos</strong>
                    <button class="btn btn-sm btn-outline-success" type="button" data-bs-toggle="collapse" data-bs-target="#secaoAdicionarComposto" aria-expanded="false">
                        <i class="bi bi-plus-circle me-1"></i> Adicionar
                    </button>
                </div>

                <!-- Filtros e Select2 -->
                <div class="collapse border-bottom px-3 pt-3" id="secaoAdicionarComposto">
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Tipo</label>
                            <select id="filtroTipoComposicao" class="form-select">
                                <option value="">-- Todos --</option>
                                <option value="Perfil">Perfil</option>
                                <option value="Componente">Componente</option>
                                <option value="Produto">Produto</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Status</label>
                            <select id="filtroStatusComposicao" class="form-select">
                                <option value="">-- Todos --</option>
                                <option value="Ativo">Ativo</option>
                                <option value="Não Ativo">Não Ativo</option>
                                <option value="Obsoleto">Obsoleto</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Tag</label>
                            <select id="filtroTagComposicao" class="form-select">
                                <option value="">-- Todas --</option>
                                @foreach (var tag in Model.AllTags)
                                {
                                    <option value="@tag.Value">@tag.Text</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col text-end">
                            <button type="button" id="limparFiltrosComposicao" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-x-circle me-1"></i> Limpar Filtros
                            </button>
                        </div>
                    </div>

                    <label class="form-label">Buscar Item ERP</label>
                    <select id="erpSelectComposicao" class="form-select w-100"></select>
                    <ul class="list-group mt-3" id="tblItensCompostos"></ul>
                </div>

                <!-- Tabela dos Itens Compostos  -->
                <div class="card-body" id="containerItensCompostos">
                    @for (int i = 0; i < Model.ItensCompostos.Count; i++)
                    {
                        <div class="card border-0 shadow-sm mb-4">
                            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                <strong>@Model.ItensCompostos[i].ItemERPDescricao</strong>
                                <input type="hidden" asp-for="ItensCompostos[@i].ItemERPId" />
                            </div>

                            <div class="card-body">
                                <div class="row g-2 mb-3">
                                    <div class="col-md-3">
                                        <label class="form-label">Comprimento</label>
                                        <input asp-for="ItensCompostos[@i].Comprimento" class="form-control form-control-sm" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Profundidade</label>
                                        <input asp-for="ItensCompostos[@i].Profundidade" class="form-control form-control-sm" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Altura</label>
                                        <input asp-for="ItensCompostos[@i].Altura" class="form-control form-control-sm" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">Quantidade</label>
                                        <input asp-for="ItensCompostos[@i].Quantidade" class="form-control form-control-sm" />
                                    </div>
                                    <div class="col-md-1 d-flex align-items-end">
                                        <button type="button" class="btn btn-sm btn-outline-danger btn-remove-composto">✕</button>
                                    </div>
                                </div>

                                <!-- Tabela de variáveis -->
                                <label class="form-label fw-semibold">Variáveis</label>
                                <table class="table table-bordered table-sm mb-2">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Nome</th>
                                            <th>Descrição</th>
                                            <th>Tipo</th>
                                            <th>Valor</th>
                                            <th>Status</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody id="variaveis_@i">
                                        @for (int j = 0; j < Model.ItensCompostos[i].Variaveis.Count; j++)
                                        {
                                            <tr>
                                                <input type="hidden" name="ItensCompostos[@i].Variaveis[@j].Id" value="@Model.ItensCompostos[i].Variaveis[j].Id" />
                                                <td>
                                                    <input name="ItensCompostos[@i].Variaveis[@j].Nome" class="form-control form-control-sm" value="@Model.ItensCompostos[i].Variaveis[j].Nome" />
                                                </td>
                                                <td>
                                                    <input name="ItensCompostos[@i].Variaveis[@j].Descricao" class="form-control form-control-sm" value="@Model.ItensCompostos[i].Variaveis[j].Descricao" />
                                                </td>
                                                <td>
                                                    <input name="ItensCompostos[@i].Variaveis[@j].Tipo" class="form-control form-control-sm" value="@Model.ItensCompostos[i].Variaveis[j].Tipo" />
                                                </td>
                                                <td>
                                                    <input name="ItensCompostos[@i].Variaveis[@j].Valor" class="form-control form-control-sm" value="@Model.ItensCompostos[i].Variaveis[j].Valor" />
                                                </td>
                                                <td>
                                                    <select name="ItensCompostos[@i].Variaveis[@j].Status" class="form-select form-select-sm">
                                                        <option value="true" selected="@(Model.ItensCompostos[i].Variaveis[j].Status ? "selected" : null)">Ativo</option>
                                                        <option value="false" selected="@(Model.ItensCompostos[i].Variaveis[j].Status == false ? "selected" : null)">Inativo</option>
                                                    </select>
                                                </td>
                                                <td>
                                                    <button type="button" class="btn btn-sm btn-outline-danger">✕</button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>


                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addVariavel(@i, @Model.ItensCompostos[i].ItemERPId)">
                                    + Adicionar variável para este item
                                </button>

                            </div>
                        </div>
                    }
                </div>
            </div>

                <!-- Bloco: Itens Galvanizados -->
                <div class="card mb-4">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <strong>Itens Galvanizados</strong>
                        <button class="btn btn-sm btn-outline-success ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#secaoAdicionarGalvanizado" aria-expanded="false">
                            <i class="bi bi-plus-circle me-1"></i> Adicionar
                        </button>
                    </div>

                    <div class="collapse border-bottom px-3 pt-3" id="secaoAdicionarGalvanizado">
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Tipo</label>
                                <select id="filtroTipoGalvanizado" class="form-select">
                                    <option value="">-- Todos --</option>
                                    <option value="Perfil">Perfil</option>
                                    <option value="Componente">Componente</option>
                                    <option value="Produto">Produto</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Status</label>
                                <select id="filtroStatusGalvanizado" class="form-select">
                                    <option value="">-- Todos --</option>
                                    <option value="Ativo">Ativo</option>
                                    <option value="Não Ativo">Não Ativo</option>
                                    <option value="Obsoleto">Obsoleto</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Tag</label>
                                <select id="filtroTagGalvanizado" class="form-select">
                                    <option value="">-- Todas --</option>
                                    @foreach (var tag in Model.AllTags)
                                    {
                                        <option value="@tag.Value">@tag.Text</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col text-end">
                                <button type="button" id="limparFiltrosGalvanizado" class="btn btn-outline-secondary btn-sm">
                                    <i class="bi bi-x-circle me-1"></i> Limpar Filtros
                                </button>
                            </div>
                        </div>

                        <label class="form-label">Buscar Itens ERP</label>
                        <select id="erpSelectGalvanizado" class="form-select w-100"></select>
                    </div>

                    <div class="card-body">
                        <table class="table table-sm" id="tblItensGalva">
                            <thead class="table-light">
                                <tr><th>Item ERP</th><th>Desenho</th><th></th></tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.ItensVinculadosGalvanizado.Count; i++)
                                {
                                    <tr>
                                        <input type="hidden" asp-for="ItensVinculadosGalvanizado[@i].Id" />
                                        <td>
                                            <input type="hidden" asp-for="ItensVinculadosGalvanizado[@i].ItemERPId" />
                                            <input type="text" class="form-control form-control-sm" value="@Model.ItensVinculadosGalvanizado[i].ItemERPDescricao" readonly />
                                        </td>
                                        <td>
                                            <select asp-for="ItensVinculadosGalvanizado[@i].DesenhoId" asp-items="Model.AllDesenhos" class="form-control form-control-sm">
                                                <option value="">-- selecione --</option>
                                            </select>
                                        </td>
                                        <td><button type="button" class="btn btn-sm btn-outline-danger btn-remove-galva">✕</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>



            <!-- Bloco: Itens Pintados -->
            <div class="card mb-4">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <strong>Itens Pintados</strong>
                    <button class="btn btn-sm btn-outline-success ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#secaoAdicionarPintado" aria-expanded="false">
                        <i class="bi bi-plus-circle me-1"></i> Adicionar
                    </button>
                </div>

                <div class="collapse border-bottom px-3 pt-3" id="secaoAdicionarPintado">
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Tipo</label>
                            <select id="filtroTipoPintado" class="form-select">
                                <option value="">-- Todos --</option>
                                <option value="Perfil">Perfil</option>
                                <option value="Componente">Componente</option>
                                <option value="Produto">Produto</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Status</label>
                            <select id="filtroStatusPintado" class="form-select">
                                <option value="">-- Todos --</option>
                                <option value="Ativo">Ativo</option>
                                <option value="Não Ativo">Não Ativo</option>
                                <option value="Obsoleto">Obsoleto</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Tag</label>
                            <select id="filtroTagPintado" class="form-select">
                                <option value="">-- Todas --</option>
                                @foreach (var tag in Model.AllTags)
                                {
                                    <option value="@tag.Value">@tag.Text</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col text-end">
                            <button type="button" id="limparFiltrosPintado" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-x-circle me-1"></i> Limpar Filtros
                            </button>
                        </div>
                    </div>

                    <label class="form-label">Buscar Itens ERP</label>
                    <select id="erpSelectPintado" class="form-select w-100"></select>
                </div>

                <div class="card-body">
                    <table class="table table-sm" id="tblItensVinculadosPintado">
                        <thead class="table-light">
                            <tr><th>Item ERP</th><th>Desenho</th><th></th></tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.ItensVinculadosPintado.Count; i++)
                            {
                                <tr>
                                    <input type="hidden" asp-for="ItensVinculadosPintado[@i].Id" />
                                    <td>
                                        <input type="hidden" asp-for="ItensVinculadosPintado[@i].ItemERPId" />
                                        <input type="text" class="form-control form-control-sm" value="@Model.ItensVinculadosPintado[i].ItemERPDescricao" readonly />
                                    </td>
                                    <td>
                                        <select asp-for="ItensVinculadosPintado[@i].DesenhoId" asp-items="Model.AllDesenhos" class="form-control form-control-sm">
                                            <option value="">-- selecione --</option>
                                        </select>
                                    </td>
                                    <td><button type="button" class="btn btn-sm btn-outline-danger btn-remove-pintado">✕</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>


    <!-- ==========================================
         Seção 2: Revisões do ItemERP
         ========================================== -->
    <div class="card mb-4">
        <div class="card-header bg-secondary text-white"><strong>Seção 2: Revisões do ItemERP</strong></div>
        <div class="card-body">
            <table class="table table-sm mb-0" id="tblRevisoesItem">
                <thead class="table-light">
                    <tr><th>Nr</th><th>Motivo</th><th>Data</th><th></th></tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Revisoes.Count; i++)
                    {
                        <tr>
                            <input type="hidden" asp-for="Revisoes[@i].Id" />
                            <td><input asp-for="Revisoes[@i].Numero" class="form-control form-control-sm" /></td>
                            <td><input asp-for="Revisoes[@i].MotivoRevisao" class="form-control form-control-sm" /></td>
                            <td><input asp-for="Revisoes[@i].DataRevisao" type="date" class="form-control form-control-sm" /></td>
                            <td><button type="button" class="btn btn-sm btn-danger btn-remove-revisao">✕</button></td>
                        </tr>
                    }
                </tbody>
            </table>
            <button type="button" id="btnAddRevisaoItem" class="btn btn-outline-secondary btn-sm mt-2">+ Revisão</button>
        </div>
    </div>

    <!-- ==========================================
         Seção 3: Propriedades – Produto
         ========================================== -->
    <div class="card mb-4">
        <div class="card-header bg-secondary text-white"><strong>Seção 3: Propriedades – Produto</strong></div>
        <div class="card-body">
            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label asp-for="ChapaAberta" class="form-label">Chapa Aberta</label>
                    <input asp-for="ChapaAberta" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Espessura" class="form-label">Espessura</label>
                    <input asp-for="Espessura" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Aco" class="form-label">Aço</label>
                    <input asp-for="Aco" class="form-control" />
                </div>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label asp-for="PesoLiquidoMetro" class="form-label">Peso Líquido</label>
                    <input asp-for="PesoLiquidoMetro" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="PesoBrutoMetro" class="form-label">Peso Bruto</label>
                    <input asp-for="PesoBrutoMetro" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="PesoLinear" class="form-label">Peso Linear</label>
                    <input asp-for="PesoLinear" type="number" step="0.01" class="form-control" />
                </div>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="AreaSuperficial" class="form-label">Área Superficial</label>
                    <input asp-for="AreaSuperficial" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="QuantidadeDobras" class="form-label">Quantidade de Dobras</label>
                    <input asp-for="QuantidadeDobras" type="number" class="form-control" />
                </div>
            </div>
        </div>
    </div>

    <!-- ==========================================
         Seção 4: Perfis da Seção
         ========================================== -->
    <div class="card mb-4">
        <div class="card-header bg-secondary text-white"><strong>Seção 4: Perfis da Seção</strong></div>
        <div class="card-body p-0">
            <table class="table mb-0" id="tblPerfisSection">
                <thead class="table-light"><tr><th>Perfil</th><th>Aço</th><th>Revisões</th><th></th></tr></thead>
                <tbody>
                    @for (int i = 0; i < Model.PerfisSection.Count; i++)
                    {
                        <tr>
                            <input type="hidden" asp-for="PerfisSection[@i].Id" />
                            <td>
                                <select asp-for="PerfisSection[@i].PerfilId" asp-items="Model.AllPerfisSection" class="form-control">
                                    <option value="">-- selecione --</option>
                                </select>
                            </td>
                            <td><input asp-for="PerfisSection[@i].Aco" class="form-control" /></td>
                            <td>
                                <table class="table table-borderless mb-0">
                                    <thead><tr><th>Nr</th><th>Motivo</th><th>Data</th></tr></thead>
                                    <tbody id="revs_@i">
                                        @for (int j = 0; j < Model.PerfisSection[i].Revisoes.Count; j++)
                                        {
                                            <tr>
                                                <input type="hidden" asp-for="PerfisSection[@i].Revisoes[@j].Id" />
                                                <td><input asp-for="PerfisSection[@i].Revisoes[@j].Numero" class="form-control form-control-sm" /></td>
                                                <td><input asp-for="PerfisSection[@i].Revisoes[@j].MotivoRevisao" class="form-control form-control-sm" /></td>
                                                <td><input asp-for="PerfisSection[@i].Revisoes[@j].DataRevisao" type="date" class="form-control form-control-sm" /></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                <button type="button" class="btn btn-sm btn-outline-secondary mt-1" onclick="addRev(@i)">+ Revisão</button>
                            </td>
                            <td><button type="button" class="btn btn-sm btn-danger btn-remove-perfil">✕</button></td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="p-3 d-flex gap-2">
                <button type="button" id="btnAddPerfilSection" class="btn btn-success btn-sm">
                    <i class="bi bi-plus-lg me-1"></i>Adicionar Perfil
                </button>
                <a asp-controller="Perfis" asp-action="Create" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-file-earmark-plus me-1"></i>Criar Perfil
                </a>
            </div>
        </div>
    </div>

    <!-- ==========================================
         Seção 5: Itens relacionados
         ========================================== -->
    <div class="card mb-4">
        <div class="card-header bg-secondary text-white"><strong>Seção 05: Itens relacionados</strong></div>
        <div class="card-body">

            <hr class="my-4" />
            <h5 class="mb-3 fw-semibold text-dark">
                <i class="bi bi-diagram-2 me-1 text-muted"></i>Este item aparece em outros como parte de:
            </h5>

            @if (Model.ApareceComoPintado.Any())
            {
                <div class="card shadow-sm border mb-3 rounded-3">
                    <div class="card-header bg-light text-dark fw-semibold">
                        <i class="bi bi-brush me-1 text-muted"></i>Como Pintado
                    </div>
                    <div class="card-body">
                        <ul class="mb-0 list-unstyled">
                            @foreach (var item in Model.ApareceComoPintado)
                            {
                                <li class="mb-1">
                                    <a href="@Url.Action("ConfiguradorItemERP", new { id = item.ItemPaiId })" class="text-decoration-none fw-medium">
                                        <i class="bi bi-link-45deg me-1 text-primary"></i>@item.ItemPaiERP
                                    </a>
                                    <span class="text-muted small"> — Desenho: <strong>@item.DesenhoNome</strong></span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }

            @if (Model.ApareceComoGalvanizado.Any())
            {
                <div class="card shadow-sm border mb-3 rounded-3">
                    <div class="card-header bg-light text-dark fw-semibold">
                        <i class="bi bi-droplet-half me-1 text-muted"></i>Como Galvanizado
                    </div>
                    <div class="card-body">
                        <ul class="mb-0 list-unstyled">
                            @foreach (var item in Model.ApareceComoGalvanizado)
                            {
                                <li class="mb-1">
                                    <a href="@Url.Action("ConfiguradorItemERP", new { id = item.ItemPaiId })" class="text-decoration-none fw-medium">
                                        <i class="bi bi-link-45deg me-1 text-primary"></i>@item.ItemPaiERP
                                    </a>
                                    <span class="text-muted small"> — Desenho: <strong>@item.DesenhoNome</strong></span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }

            @if (Model.ApareceComoIntegrante.Any())
            {
                <div class="card shadow-sm border mb-3 rounded-3">
                    <div class="card-header bg-light text-dark fw-semibold">
                        <i class="bi bi-diagram-3 me-1 text-muted"></i>Como Integrante
                    </div>
                    <div class="card-body">
                        <ul class="mb-0 list-unstyled">
                            @foreach (var item in Model.ApareceComoIntegrante)
                            {
                                <li class="mb-1">
                                    <a href="@Url.Action("ConfiguradorItemERP", new { id = item.ItemPaiId })" class="text-decoration-none fw-medium">
                                        <i class="bi bi-link-45deg me-1 text-primary"></i>@item.ItemPaiERP
                                    </a>
                                    <span class="text-muted small"> — Desenho: <strong>@item.DesenhoNome</strong></span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- ==========================================
     Seção 6: Famílias
     ========================================== -->
    <div class="card mb-4">
        <div class="card-header bg-secondary text-white">
            <strong>Seção 6: Famílias</strong>
        </div>
        <div class="card-body">
            <div class="row">
                <!-- Componentes -->
                <div class="col-md-6">
                    <h5>Componentes</h5>
                    <table class="table table-sm mb-2" id="tblComponentesFamily">
                        <thead class="table-light">
                            <tr><th>Componente</th><th></th></tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.ComponentesFamily.Count; i++)
                            {
                                <tr>
                                    <input type="hidden" asp-for="ComponentesFamily[@i].Id" />
                                    <td>
                                        <select asp-for="ComponentesFamily[@i].ComponenteId"
                                                asp-items="Model.AllComponentes"
                                                class="form-control form-control-sm">
                                            <option value="">-- selecione --</option>
                                        </select>
                                    </td>
                                    <td>
                                        <button type="button"
                                                class="btn btn-sm btn-danger btn-remove-componente">
                                            ✕
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <button type="button"
                            id="btnAddComponenteFamily"
                            class="btn btn-success btn-sm">
                        <i class="bi bi-plus-lg me-1"></i>Adicionar Componente
                    </button>
                </div>

                <!-- Agrupadores -->
                <div class="col-md-6">
                    <h5>Agrupadores</h5>
                    <table class="table table-sm mb-2" id="tblAgrupadoresFamily">
                        <thead class="table-light">
                            <tr><th>Agrupador</th><th></th></tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.AgrupadoresFamily.Count; i++)
                            {
                                <tr>
                                    <input type="hidden" asp-for="AgrupadoresFamily[@i].Id" />
                                    <td>
                                        <select asp-for="AgrupadoresFamily[@i].AgrupadorId"
                                                asp-items="Model.AllAgrupadores"
                                                class="form-control form-control-sm">
                                            <option value="">-- selecione --</option>
                                        </select>
                                    </td>
                                    <td>
                                        <button type="button"
                                                class="btn btn-sm btn-danger btn-remove-agrupador">
                                            ✕
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <button type="button"
                            id="btnAddAgrupadorFamily"
                            class="btn btn-success btn-sm">
                        <i class="bi bi-plus-lg me-1"></i>Adicionar Agrupador
                    </button>
                </div>
            </div>
        </div>



    <button type="submit" class="btn btn-primary mb-4">Salvar todas as configurações</button>
</form>

<div asp-validation-summary="All" class="text-danger mb-3"></div>

@section Scripts {
    <script>
        const itensOptions       = `@Html.Raw(itensOptions)`;
        const desenhosOptions    = `@Html.Raw(desenhosOptions)`;
        const perfisOptions      = `@Html.Raw(perfisOptions)`;
        const componentesOptions = `@Html.Raw(string.Join("", Model.AllComponentes.Select(c => $"<option value='{c.Value}'>{c.Text}</option>")))`;
        const agrupadoresOptions = `@Html.Raw(string.Join("", Model.AllAgrupadores.Select(a => $"<option value='{a.Value}'>{a.Text}</option>")))`;

        function formatItemComposicao(item) {
            if (!item.id) return item.text;
            const parts = item.text.split('|');
            return $('<span><strong>' + parts[0] + '</strong> — ' + parts[1] + ' <small class="text-muted">(' + parts[2] + ')</small></span>');
        }


        //tags

          $(document).ready(function () {
            $('.select2-tags').select2({
                placeholder: "Selecione as tags...",
                allowClear: true,
                width: 'resolve'
            });
        });


                $('.select2-tags').select2({
            theme: 'bootstrap4',
            placeholder: "Selecione as tags...",
            allowClear: true,
            width: 'resolve'
        });





        // desenhos - o card nao os vinculos de acabmento
            $(document).ready(function () {
            const $select = $('#desenhoSelectTemp');

            $select.select2({
                placeholder: "Buscar desenho...",
                ajax: {
                    url: '/ItensERP/BuscarDesenhoItemERP',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return {
                            term: params.term,
                            status: $('#filtroStatusDesenho').val()
                        };
                    },
                processResults: function (data) {
                    return {
                        results: data.map(item => ({
                        id: item.id,
                        text: item.text,
                        nome: item.nome,
                        descricao: item.descricao,
                        revisao: item.revisao,
                        dataCriacao: item.dataCriacao
                    }))
                };
            }

                },
                width: '100%'
            });

                    $select.on('select2:select', function (e) {
            const item = e.params.data;
            const index = document.querySelector('#tblDesenhos tbody').rows.length;

            // Trata datas para input[type=date]
            const formatarData = (dataStr) => {
                if (!dataStr) return '';
                // Se já estiver no formato yyyy-MM-dd, retorna direto
                if (/^\d{4}-\d{2}-\d{2}$/.test(dataStr)) return dataStr;
                const data = new Date(dataStr);
                if (isNaN(data)) return '';
                return data.toISOString().split('T')[0];
            };

            // Debug (ativa no console pra ver o conteúdo real)
            console.log('Desenho selecionado:', item);

            const novaLinha = `
                <tr>
                    <input type="hidden" name="Desenhos[${index}].Id" value="${item.id}" />
                    <td><input name="Desenhos[${index}].Nome" class="form-control form-control-sm" value="${item.nome || ''}" /></td>
                    <td><input name="Desenhos[${index}].Descricao" class="form-control form-control-sm" value="${item.descricao || ''}" /></td>
                    <td><input name="Desenhos[${index}].Revisao" class="form-control form-control-sm" value="${item.revisao || ''}" /></td>
                    <td><input name="Desenhos[${index}].DataCriacao" type="date" class="form-control form-control-sm" value="${formatarData(item.dataCriacao)}" /></td>
                    <td><button type="button" class="btn btn-sm btn-outline-danger btn-remove-desenho">✕</button></td>
                </tr>
            `;

            document.querySelector('#tblDesenhos tbody').insertAdjacentHTML('beforeend', novaLinha);
            $select.val(null).trigger('change');
        });

                // Remove uma linha da tabela de desenhos
        $(document).on('click', '.btn-remove-desenho', function () {
            $(this).closest('tr').remove();
        });


            $('#btnAddDesenho').on('click', function () {
                $('#desenhoSelectTemp').select2('open');
            });
        });



             function verificarSintaxe() {
            const expressao = document.getElementById("FormulaExpressao").value;

            if (!expressao || expressao.length < 3) {
                alert("Expressão muito curta.");
                return;
            }

            try {
                // tentativa simples (não executa, só avalia estrutura)
                new Function("return " + expressao);
                alert("Sintaxe válida.");
            } catch (e) {
                alert("Sintaxe inválida: " + e.message);
            }
        }





                function addComposicaoRow(item) {
            const index = document.querySelectorAll('#containerItensCompostos .card').length;

            const html = `
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <strong>${item.text}</strong>
                        <input type="hidden" name="ItensCompostos[${index}].ItemERPId" value="${item.id}" />
                    </div>

                    <div class="card-body">
                        <div class="row g-2 mb-3">
                            <div class="col-md-3">
                                <label class="form-label">Comprimento</label>
                                <input name="ItensCompostos[${index}].Comprimento" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Profundidade</label>
                                <input name="ItensCompostos[${index}].Profundidade" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Altura</label>
                                <input name="ItensCompostos[${index}].Altura" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Quantidade</label>
                                <input name="ItensCompostos[${index}].Quantidade" class="form-control form-control-sm" value="1" />
                            </div>
                            <div class="col-md-1 d-flex align-items-end">
                                <button type="button" class="btn btn-sm btn-outline-danger btn-remove-composto">✕</button>
                            </div>
                        </div>

                        <label class="form-label fw-semibold">Variáveis</label>
                        <table class="table table-bordered table-sm mb-2">
                            <thead class="table-light">
                                <tr>
                                    <th>Nome</th>
                                    <th>Descrição</th>
                                    <th>Tipo</th>
                                    <th>Valor</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="variaveis_${index}">
                            </tbody>
                        </table>

                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addVariavel(${index}, ${item.id})">
                            + Adicionar variável para este item
                        </button>
                    </div>
                </div>
            `;

            document.getElementById('containerItensCompostos').insertAdjacentHTML('beforeend', html);
        }








                function addVariavel(indexItem, itemERPId) {
            const tbody = document.querySelector(`#variaveis_${indexItem}`);
            const rowCount = tbody.rows.length;

            const novaLinha = `
                <tr>
                    <input type="hidden" name="ItensCompostos[${indexItem}].Variaveis[${rowCount}].Id" value="0" />
                    <input type="hidden" name="ItensCompostos[${indexItem}].Variaveis[${rowCount}].ItemERPCompostoId" value="${itemERPId}" />
                    <td><input name="ItensCompostos[${indexItem}].Variaveis[${rowCount}].Nome" class="form-control form-control-sm" /></td>
                    <td><input name="ItensCompostos[${indexItem}].Variaveis[${rowCount}].Descricao" class="form-control form-control-sm" /></td>
                    <td><input name="ItensCompostos[${indexItem}].Variaveis[${rowCount}].Tipo" class="form-control form-control-sm" /></td>
                    <td><input name="ItensCompostos[${indexItem}].Variaveis[${rowCount}].Valor" class="form-control form-control-sm" /></td>
                    <td>
                        <select name="ItensCompostos[${indexItem}].Variaveis[${rowCount}].Status" class="form-select form-select-sm">
                            <option value="true">Ativo</option>
                            <option value="false">Inativo</option>
                        </select>
                    </td>
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('tr').remove()">✕</button>
                    </td>
                </tr>
            `;

            tbody.insertAdjacentHTML("beforeend", novaLinha);
        }






        function setupSelect2ComFiltrosERP({ selectId, filtroTipo, filtroStatus, filtroTag, botaoLimpar }) {
            const $select = $('#' + selectId);

            $select.select2({
                placeholder: "Buscar Itens ERP...",
                ajax: {
                    url: '/ItensERP/BuscarItensERP',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return {
                            term: params.term,
                            tipoItem: $('#' + filtroTipo).val(),
                            status: $('#' + filtroStatus).val(),
                            tag: $('#' + filtroTag).val()
                        };
                    },
                    processResults: function (data) {
                        return { results: data };
                    },
                    cache: true
                },
                templateResult: formatItemComposicao,
                templateSelection: function (item) {
                    if (!item.id) return item.text;
                    return item.text.split('|')[0];
                },
                width: '100%',
                allowClear: true
            });

            $('#' + filtroTipo + ', #' + filtroStatus + ', #' + filtroTag).on('change', function () {
                $select.select2('open');
            });

            $('#' + botaoLimpar).on('click', function () {
                $('#' + filtroTipo + ', #' + filtroStatus + ', #' + filtroTag).val('');
                $select.select2('open');
            });

            $select.on('select2:select', function (e) {
                const item = e.params.data;
                const parts = item.text.split('|');

                const indices = {
                    erpSelectComposicao: document.querySelector('#tblItensCompostos tbody').rows.length,
                    erpSelectPintado: document.querySelector('#tblItensVinculadosPintado tbody').rows.length,
                    erpSelectGalvanizado: document.querySelector('#tblItensGalva tbody').rows.length
                };
                const index = indices[selectId];

                let rowHtml = '';
                let targetTableId = '';

                       if (selectId === 'erpSelectComposicao') {
            addComposicaoRow(item); // <-- já monta o card e insere no lugar certo
            $select.val(null).trigger('change');
            return;
            }


                if (selectId === 'erpSelectPintado') {
                    rowHtml = `
                        <tr>
                            <td>
                                <input type="hidden" name="ItensVinculadosPintado[${index}].ItemERPId" value="${item.id}" />
                                <input type="text" class="form-control form-control-sm" value="${parts[0]} — ${parts[1]}" readonly />
                            </td>
                            <td>
                                <select name="ItensVinculadosPintado[${index}].DesenhoId" class="form-control form-control-sm">
                                    <option value="">-- selecione --</option>
                                    ${desenhosOptions}
                                </select>
                            </td>
                            <td><button type="button" class="btn btn-sm btn-outline-danger btn-remove-pintado">✕</button></td>
                        </tr>`;
                    targetTableId = 'tblItensVinculadosPintado';
                }

                if (selectId === 'erpSelectGalvanizado') {
                    rowHtml = `
                        <tr>
                            <td>
                                <input type="hidden" name="ItensVinculadosGalvanizado[${index}].ItemERPId" value="${item.id}" />
                                <input type="text" class="form-control form-control-sm" value="${parts[0]} — ${parts[1]}" readonly />
                            </td>
                            <td>
                                <select name="ItensVinculadosGalvanizado[${index}].DesenhoId" class="form-control form-control-sm">
                                    <option value="">-- selecione --</option>
                                    ${desenhosOptions}
                                </select>
                            </td>
                            <td><button type="button" class="btn btn-sm btn-outline-danger btn-remove-galva">✕</button></td>
                        </tr>`;
                    targetTableId = 'tblItensGalva';
                }

                document.querySelector(`#${targetTableId} tbody`).insertAdjacentHTML('beforeend', rowHtml);
                $select.val(null).trigger('change');
            });
        }

        // Inicializações
        setupSelect2ComFiltrosERP({
            selectId: 'erpSelectComposicao',
            filtroTipo: 'filtroTipoComposicao',
            filtroStatus: 'filtroStatusComposicao',
            filtroTag: 'filtroTagComposicao',
            botaoLimpar: 'limparFiltrosComposicao'
        });

        setupSelect2ComFiltrosERP({
            selectId: 'erpSelectPintado',
            filtroTipo: 'filtroTipoPintado',
            filtroStatus: 'filtroStatusPintado',
            filtroTag: 'filtroTagPintado',
            botaoLimpar: 'limparFiltrosPintado'
        });

        setupSelect2ComFiltrosERP({
            selectId: 'erpSelectGalvanizado',
            filtroTipo: 'filtroTipoGalvanizado',
            filtroStatus: 'filtroStatusGalvanizado',
            filtroTag: 'filtroTagGalvanizado',
            botaoLimpar: 'limparFiltrosGalvanizado'
        });

        document.addEventListener('click', e => {
            if (e.target.classList.contains('btn-remove-composto')) e.target.closest('tr').remove();
            if (e.target.classList.contains('btn-remove-pintado'))  e.target.closest('tr').remove();
            if (e.target.classList.contains('btn-remove-galva'))    e.target.closest('tr').remove();
        });
    </script>
}