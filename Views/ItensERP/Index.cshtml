@* Views/ItensERP/Index.cshtml *@
@model IEnumerable<Gerenciador_de_Produtos.Models.ItemERP>

@{
    ViewData["Title"] = "Itens ERP";
}

<!-- Estilos de rotação do ícone (mova para site.css) -->
<style>
    .toggle-icon {
        transition: transform 0.3s ease;
    }

    .toggle-collapsed .toggle-icon {
        transform: rotate(-90deg);
    }
</style>

<div class="mb-4">
    <h3 class="fw-bold mb-3">@ViewData["Title"]</h3>
    <div class="row g-2">
        <div class="col-auto">
            <a asp-action="Create" class="btn btn-primary rounded-pill py-0 px-3">
                <i class="bi bi-plus-lg me-1"></i>Novo ItemERP
            </a>

        </div>
        <div class="col-auto">
            <a asp-action="ImportarLST" class="btn btn-outline-success rounded-pill py-0 px-3">
                <i class="bi bi-upload me-1"></i> Importar LST
            </a>
        </div>

        <div class="col">
            <input id="searchInput" class="form-control" placeholder="Buscar ERP, descrição ou tipo..." />
        </div>
    </div>
</div>


<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Tipo</label>
                <select id="filtroTipo" class="form-select">
                    <option value="">-- Todos --</option>
                    <option value="Perfil">Perfil</option>
                    <option value="Componente">Componente</option>
                    <option value="Galvanizado">Galvanizado</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Status</label>
                <select id="filtroStatus" class="form-select">
                    <option value="">-- Todos --</option>
                    <option value="Ativo">Ativo</option>
                    <option value="NaoAtivo">Não Ativo</option>
                    <option value="Obsoleto">Obsoleto</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Tag</label>
                <select id="filtroTag" class="form-select">
                    <option value="">-- Todas --</option>
                    @foreach (var tag in ViewBag.AllTags as List<SelectListItem>)
                    {
                        <option value="@tag.Value">@tag.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <input id="searchTerm" class="form-control" placeholder="Buscar ERP ou descrição..." />
            </div>
        </div>

        <div class="mt-3 text-end">
            <button class="btn btn-outline-secondary" id="btnLimparFiltros">
                <i class="bi bi-x-circle me-1"></i> Limpar Filtros
            </button>
        </div>
    </div>
</div>

<div id="itensERPContainer">
    <div class="text-center text-muted py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-3">Carregando itens...</p>
    </div>
</div>


@section Scripts {
    <script>
        document.getElementById('searchInput').addEventListener('input', function() {
            var filtro = this.value.toLowerCase();
            document.querySelectorAll('[data-search]').forEach(function(card) {
                card.style.display = card.getAttribute('data-search').toLowerCase().includes(filtro) ? '' : 'none';
            });
        });

        document.querySelectorAll('.toggle-btn').forEach(function(btn) {
            btn.classList.add('toggle-collapsed');
            btn.addEventListener('click', function() {
                btn.classList.toggle('toggle-collapsed');
            });
        });
               function carregarItens() {
            const filtros = {
                tipo: $('#filtroTipo').val(),
                status: $('#filtroStatus').val(),
                tag: $('#filtroTag').val(),
                termo: $('#searchTerm').val()
            };

            $('#itensERPContainer').html(`
                <div class="text-center text-muted py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-3">Carregando itens...</p>
                </div>`);

            $.get('/ItensERP/Filtrar', filtros, function (html) {
                $('#itensERPContainer').html(html);
            });
        }

        $('#filtroTipo, #filtroStatus, #filtroTag').on('change', carregarItens);
        $('#searchTerm').on('input', function () {
            clearTimeout(this.delay);
            this.delay = setTimeout(carregarItens, 400);
        });

        $('#btnLimparFiltros').click(function () {
            $('#filtroTipo, #filtroStatus, #filtroTag').val('');
            $('#searchTerm').val('');
            carregarItens();
        });

        // Carregamento inicial
        $(document).ready(carregarItens);

    </script>
}
