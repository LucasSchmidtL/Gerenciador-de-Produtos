@{
    ViewData["Title"] = "Importar Arquivo LST";
}

<h1 class="display-6 fw-bold text-primary mb-4">
    <i class="bi bi-upload me-2"></i> @ViewData["Title"]
</h1>

<form asp-action="ImportarLST" method="post" enctype="multipart/form-data">
    <div class="mb-3">
        <label for="arquivo" class="form-label">Selecione o arquivo .LST:</label>
        <input type="file" class="form-control" name="arquivo" required />
    </div>

    <button type="submit" class="btn btn-success rounded-pill px-4">
        <i class="bi bi-arrow-up-circle me-1"></i> Enviar e Validar
    </button>
</form>
